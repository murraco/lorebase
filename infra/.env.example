# Copy this file to get started:
#   - Local (non-Docker) backend work: cp infra/.env.example backend/.env
#   - Docker Compose:                  cp infra/.env.example infra/.env
#
# Never commit the resulting .env files — both paths are covered by
# .gitignore.

# --- Django ---
# Generate one with: uv run --project backend python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# One of: config.settings.dev, config.settings.test, config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database (must match the pgvector/pgvector Postgres image used in Docker Compose) ---
DATABASE_URL=postgres://lorebase:lorebase@localhost:5432/lorebase

# --- Redis (Celery broker/result backend + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM / embeddings providers (added starting Etapa 9) ---
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
