# Copy this file to get started:
#   - Docker Compose:                  cp infra/.env.example infra/.env
#   - Local (non-Docker) backend work: cp infra/.env.example backend/.env
#
# Never commit the resulting .env files — both paths are covered by
# .gitignore.
#
# Every variable Lorebase reads is listed here. Values that are commented
# out show the default the code applies when the variable is absent, so
# copying this file verbatim gives a working configuration and every line
# you uncomment is a deliberate override.


# ─── Django ──────────────────────────────────────────────────────────
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Don't use Django's own get_random_secret_key() for this file: its charset
# includes "$", which docker-compose interprets as the start of a ${VAR}
# reference and silently strips from the value. token_urlsafe() only uses
# letters, digits, "-", and "_" — safe in any .env file.
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# One of: config.settings.dev, config.settings.test, config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev


# ─── Database ────────────────────────────────────────────────────────
# POSTGRES_* configure the `db` container itself, and are read by
# docker-compose for variable substitution — they matter only in
# infra/.env.
POSTGRES_USER=lorebase
POSTGRES_PASSWORD=lorebase
POSTGRES_DB=lorebase
# For Django running OUTSIDE Docker, pointing at the port Compose
# publishes on the host. Inside Docker the backend and worker reach the
# database at `db:5432`, which docker-compose.yml sets directly, so this
# value is ignored there. Published as 5434, not 5432: adjust if you
# don't already have a native Postgres on 5432.
DATABASE_URL=postgres://lorebase:lorebase@localhost:5434/lorebase


# ─── Redis (Celery broker/results, and Django's cache) ───────────────
# Same idea as DATABASE_URL: these are for running outside Docker.
# Separate database indexes so queue data and cache data stay apart —
# nothing would break sharing one, the key names don't collide.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1


# ─── Notes to index ──────────────────────────────────────────────────
# An absolute path on YOUR machine, bind-mounted read-only into the
# container at /app/storage/external so the source picker can reach it.
# The picker browses the *server's* filesystem — no browser API can hand
# a server a host path — so anything you want indexed has to be mounted.
# Only used by docker-compose.
# LOREBASE_NOTES_DIR=/Users/you/Documents/notes


# ─── Embeddings ──────────────────────────────────────────────────────
# "local" (default), "voyage", or "fake". The default runs a bi-encoder
# in-process via sentence-transformers: no API key and no rate limit, at
# the cost of a multi-hundred-MB model download on first use.
# EMBEDDING_PROVIDER=local
#
# Used when EMBEDDING_PROVIDER=local. Must output 1024-dimensional
# vectors to match EMBEDDING_DIMENSIONS below, or the pgvector column
# needs a migration.
# LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large
#
# Used when EMBEDDING_PROVIDER=voyage.
# EMBEDDING_MODEL=voyage-4
#
# Fixed at column-creation time: pgvector bakes the dimension into the
# Postgres column, so changing this on a populated database means a
# migration plus a full re-embed.
# EMBEDDING_DIMENSIONS=1024
#
# $/million tokens, for cost logging only — never wired into a billing
# path. No default rather than a guessed number, so an out-of-date price
# can't masquerade as fact. Voyage listed voyage-4 at $0.06/M in 2026-08.
# EMBEDDING_COST_PER_MILLION_TOKENS_USD=0.06


# ─── Reranking ───────────────────────────────────────────────────────
# "local" (default), "voyage", or "fake". Same trade-off as embeddings,
# with a cross-encoder instead of a bi-encoder.
# RERANK_PROVIDER=local
#
# Used when RERANK_PROVIDER=local.
# LOCAL_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
#
# Used when RERANK_PROVIDER=voyage. rerank-2.5 is current; rerank-2 is
# legacy.
# RERANK_MODEL=rerank-2.5


# ─── Retrieval ───────────────────────────────────────────────────────
# "lexical", "dense", "hybrid", or "hybrid_reranked" (default).
# "lexical" and "dense" exist to measure one half in isolation and skip
# the date-matching wrapper on purpose.
# RETRIEVAL_STRATEGY=hybrid_reranked


# ─── Answers ─────────────────────────────────────────────────────────
# "anthropic" (default) or "fake" (deterministic, no network — what CI
# uses so it needs no API key).
# LLM_PROVIDER=anthropic
#
# Haiku rather than Sonnet: a deliberate cost choice for this project,
# not a capability ceiling.
# LLM_MODEL=claude-haiku-4-5-20251001
#
# $/million tokens, logging only, same reasoning as the embedding cost
# above. Haiku 4.5 was $1/MTok in and $5/MTok out as of 2026-08.
# LLM_COST_PER_MILLION_INPUT_TOKENS_USD=1
# LLM_COST_PER_MILLION_OUTPUT_TOKENS_USD=5


# ─── Ingestion ───────────────────────────────────────────────────────
# Safety net in bytes: parsing and chunking work in memory, not
# streaming, so one pathological file could exhaust it. Connectors skip
# and log anything larger instead of trying. Default is 10 MB.
# MAX_DOCUMENT_SIZE_BYTES=10485760


# ─── API keys ────────────────────────────────────────────────────────
# Only needed for the providers you actually select above. With the
# defaults (local embeddings and reranking) the Anthropic key is the only
# one required, and it is only needed to answer questions — indexing and
# search work without it.
ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
