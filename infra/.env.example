# Copy this file to get started:
#   - Local (non-Docker) backend work: cp infra/.env.example backend/.env
#   - Docker Compose:                  cp infra/.env.example infra/.env
#
# Never commit the resulting .env files — both paths are covered by
# .gitignore.

# --- Django ---
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Don't use Django's own get_random_secret_key() for this file: its charset
# includes "$", which docker-compose interprets as the start of a ${VAR}
# reference and silently strips from the value. token_urlsafe() only uses
# letters, digits, "-", and "_" — safe in any .env file.
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# One of: config.settings.dev, config.settings.test, config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database ---
# POSTGRES_USER/PASSWORD/DB configure the `db` container itself (used only
# by infra/.env, read by docker-compose.yml for variable substitution).
POSTGRES_USER=lorebase
POSTGRES_PASSWORD=lorebase
POSTGRES_DB=lorebase
# DATABASE_URL is for Django running OUTSIDE Docker (backend/.env), pointing
# at the port Compose publishes on the host. Inside Docker, the backend and
# worker services connect via the `db` hostname instead — docker-compose.yml
# overrides DATABASE_URL for them, so this value is ignored there.
# Published as 5434, not 5432: adjust if you don't have a native Postgres
# already using 5432 on your machine.
DATABASE_URL=postgres://lorebase:lorebase@localhost:5434/lorebase

# --- Redis (Celery broker/result backend) ---
# Same idea as DATABASE_URL: this is for Django outside Docker. Inside
# Docker, backend/worker use redis://redis:6379/0 instead.
REDIS_URL=redis://localhost:6379/0
# Separate DB index for Django's cache (used for the per-source sync lock),
# kept apart from the Celery broker/backend above. Inside Docker,
# backend/worker use redis://redis:6379/1 instead.
REDIS_CACHE_URL=redis://localhost:6379/1

# --- LLM / embeddings providers (added once retrieval needs them) ---
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# --- Embeddings ---
# "voyage" (default), "local", or "fake". "local" runs a bi-encoder
# in-process via sentence-transformers — no API key, no rate limit, at the
# cost of a multi-hundred-MB model download on first use. See
# rag/embeddings/local.py.
# EMBEDDING_PROVIDER=local

# --- Reranking ---
# "voyage" (default), "local", or "fake". "local" runs a cross-encoder
# in-process via sentence-transformers — no API key, no rate limit, at the
# cost of a multi-hundred-MB model download on first use. See
# rag/reranking/local.py.
# RERANK_PROVIDER=local
