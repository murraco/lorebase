# Copy to infra/.env.prod, fill in real values, then:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d
#
# Unlike infra/.env.example, nothing here has a default baked into
# docker-compose.prod.yml -- a production deployment should never
# silently fall back to a dev credential. Every variable below is
# required; the stack will refuse to start (or start insecurely) without
# real values.

# ─── Django ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Must be long and random -- `manage.py check --deploy` (settings/prod.py)
# warns if it looks auto-generated or short. Never reuse the dev key.
DJANGO_SECRET_KEY=

# The real domain(s) this deploys to, comma-separated. No default, on
# purpose: Django refuses every request with a Host header not in this
# list, which is the point.
DJANGO_ALLOWED_HOSTS=

# ─── Database ────────────────────────────────────────────────────────
# Real credentials, not "lorebase"/"lorebase" -- docker-compose.prod.yml
# has no fallback default for these.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=lorebase

# ─── LLM / embeddings / reranking providers ───────────────────────────
# Same variables as infra/.env.example -- see that file for what each
# one does and its default. Copy over whichever ones you've set there.
ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=local
# RERANK_PROVIDER=local
# LLM_COST_PER_MILLION_INPUT_TOKENS_USD=1
# LLM_COST_PER_MILLION_OUTPUT_TOKENS_USD=5

# ─── Observability ─────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# ─── GitHub connector (optional) ───────────────────────────────────────
# GITHUB_TOKEN=

# ─── MCP server ──────────────────────────────────────────────────────
# The real, externally-reachable URL for the MCP server -- see
# docs/mcp-server.md.
# MCP_SERVER_URL=
