# openapi-typescript@7.13.0 still declares a `typescript@^5.x` peer, but
# Angular 22 ships TypeScript 6.0 — a build-time-only tool's stale peer
# range, not an actual incompatibility. Without this, `npm ci` (used in
# Docker builds and CI) fails on the same conflict `npm install` needs
# --legacy-peer-deps for locally.
legacy-peer-deps=true
